# Add your Anthropic API key here
# Get it from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

PORT=3000
NODE_ENV=development

# Railway backend URL for WebSocket connections
# This tells the frontend where to connect for real-time game features
# Replace with your actual Railway domain (without https://)
NEXT_PUBLIC_WS_URL=your-app.up.railway.app

# Google Gemini API key for AI movie poster generation
# Get it from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Additional allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=

# Firebase Storage bucket for generated poster images
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Stripe payment integration for credit purchases
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
